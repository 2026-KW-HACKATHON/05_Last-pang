# Edge Function 비밀값 이름만 적는다. 실제 값은 supabase/functions/.env (로컬) 또는
# npx supabase secrets set KEY=값 (원격)으로 넣고 절대 커밋하지 않는다. VITE_를 붙이지 않는다
KAKAO_REST_API_KEY=
ANTHROPIC_API_KEY=
# 웹 푸시 (send-push). 키 만들기: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY는 브라우저용 VITE_VAPID_PUBLIC_KEY와 같은 값이고, PRIVATE는 여기(시크릿)에만 둔다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Vault의 push_cron_secret과 같은 값 (cron만 이 함수를 부를 수 있게)
PUSH_CRON_SECRET=
