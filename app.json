{
  "expo": {
    "name": "라스트팡",
    "slug": "lastpang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mascot/wave.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/mascot/wave.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCF9F8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lastpang.app"
    },
    "android": {
      "package": "com.lastpang.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/mascot/wave.png",
        "backgroundColor": "#FCF9F8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
